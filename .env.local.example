# ─────────────────────────────────────────────────────────────
# Rizq — local environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — the app throws without these) ──
# Supabase dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App ──
# Base URL used to build auth redirect links (email verify, OAuth, password reset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── PostHog analytics (optional — disabled when unset) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry error tracking (optional — disabled when unset) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── DeepSeek API (server-only — used for reasoned pricing priors + all AI features) ──
DEEPSEEK_API_KEY=
