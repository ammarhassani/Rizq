# ─────────────────────────────────────────────────────────────
# Rizq — local environment variables
# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── Supabase (REQUIRED — the app throws without these) ──
# Supabase dashboard → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── App ──
# Base URL used to build auth redirect links (email verify, OAuth, password reset)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── PostHog analytics (optional — disabled when unset) ──
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Sentry error tracking (optional — disabled when unset) ──
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── DeepSeek API (server-only — used for reasoned pricing priors + all AI features) ──
DEEPSEEK_API_KEY=

# ── Project integrations · GitHub OAuth (server-only — optional) ──
# When unset, the project Integrations tab shows manual link-attach only (no
# "Connect GitHub" button). To enable real connections, register a GitHub OAuth
# App (Authorization callback URL = <NEXT_PUBLIC_APP_URL>/api/integrations/github/callback)
# and set both values. Scope requested is read-only (read:user).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Envelope-encryption key for stored provider tokens (server-only — REQUIRED for
# provider connections). 32 bytes as base64 or hex. Generate e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Tokens are AES-256-GCM encrypted with this key before they touch the DB;
# never expose it and never prefix it with NEXT_PUBLIC_.
PROVIDER_TOKEN_KEY=
